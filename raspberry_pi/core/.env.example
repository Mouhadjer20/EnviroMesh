## EnviroMesh Core — Environment Variables Template (RPi 2)
##
## USAGE
## -----
##   cp .env.example .env
##   nano .env        # fill in real values — never commit .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
AUTH_REQUIRED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Web dashboard / Nginx
# ---------------------------------------------------------------------------
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Central EMQX broker (on this RPi 2)
# ---------------------------------------------------------------------------
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_DASHBOARD_PASSWORD
EMQX_NODE_COOKIE=REPLACE_WITH_STRONG_COOKIE

# Application (backend subscriber) account on core EMQX
MQTT_APP_USERNAME=enviromesh_backend
MQTT_APP_PASSWORD=REPLACE_WITH_STRONG_BACKEND_PASSWORD

# ---------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# ---------------------------------------------------------------------------
POSTGRES_DB=enviromesh
POSTGRES_USER=enviromesh_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ---------------------------------------------------------------------------
# LAN / networking (informational — used in docs and scripts)
# ---------------------------------------------------------------------------
# IP of this RPi 2 — recommend DHCP reservation or static IP
CORE_LAN_IP=192.168.1.5
# IP of RPi 1 gateway (used in firewall docs)
GATEWAY_LAN_IP=192.168.1.20
