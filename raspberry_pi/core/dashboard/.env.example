# ==============================================================================
# EnviroMesh Dashboard — Example Environment Variables
# Copy this file to .env before running `npm run dev`.
# These variables are consumed by Vite at dev-server startup only.
# In Docker (compose), Nginx handles API routing — these are NOT baked into
# the production bundle.
# ==============================================================================

# Dev-server reverse proxy target for /api/* requests.
# Must match WEB_PORT in the root .env (docker-compose nginx gateway).
# Default: http://localhost:8080 (matching root .env; 8081 if WEB_PORT is unset).
VITE_API_PROXY=http://localhost:8080
