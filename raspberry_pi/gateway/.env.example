## EnviroMesh Gateway — Environment Variables Template (RPi 1)
##
## USAGE
## -----
##   cp .env.example .env
##   nano .env          # fill in real values — never commit .env
##
## All values are consumed by docker-compose.yml and gateway/config.py.

# ---------------------------------------------------------------------------
# Gateway identity
# ---------------------------------------------------------------------------
GATEWAY_ID=GW01
# LAN IP of this RPi 1 (recommend DHCP reservation or static config)
GATEWAY_LAN_IP=192.168.1.20

# ---------------------------------------------------------------------------
# Local EMQX broker (on this RPi 1)
# ---------------------------------------------------------------------------
MQTT_BIND_IP=0.0.0.0
MQTT_LOCAL_PORT=1883

# Credentials for the gateway ingestion service account on the local broker.
# Create this account via: docker exec enviromesh-emqx-local emqx ctl admins add
MQTT_LOCAL_USERNAME=gw_ingestion
MQTT_LOCAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# EMQX management dashboard
EMQX_DASHBOARD_BIND_IP=127.0.0.1
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_DASHBOARD_PASSWORD

# ---------------------------------------------------------------------------
# Core EMQX on RPi 2 (TLS — port 8883)
# ---------------------------------------------------------------------------
# IP or hostname of RPi 2 — use DHCP reservation or static IP
MQTT_CORE_HOST=192.168.1.5
MQTT_CORE_PORT=8883

# Credentials for the gateway forwarder account on the core broker.
MQTT_CORE_USERNAME=gw_forwarder
MQTT_CORE_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Queue tuning
# ---------------------------------------------------------------------------
QUEUE_MAX_MESSAGES=50000
FORWARD_BATCH_SIZE=10
FORWARD_RETRY_SECONDS=5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

