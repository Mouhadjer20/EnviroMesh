
# ==========================================
# EnviroMesh - Application
# ==========================================
APP_ENV=production

# ==========================================
# Web dashboard / Nginx
# ==========================================
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080

# ==========================================
# EMQX MQTT broker
# ==========================================
MQTT_BIND_IP=0.0.0.0
MQTT_PORT=1883
EMQX_URL=URL_OF_EMQX
MQTT_HOST=HOST_OF_MQTT
MQTT_TOPIC=enviromesh/devices/+/telemetry
TOPIC_PRIFIX=enviromesh/devices/+/telemetry

# EMQX administration dashboard
# 0.0.0.0 = accessible from any device on the same LAN subnet as the RPi
# Set to 127.0.0.1 to restrict access to localhost only
EMQX_DASHBOARD_BIND_IP=0.0.0.0
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
EMQX_DASHBOARD_PORT=18083

# MQTT application account
# Create this account in EMQX and configure topic permissions.
MQTT_APP_USERNAME=enviromesh_backend
MQTT_APP_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD

# ==========================================
# PostgreSQL / TimescaleDB
# ==========================================
POSTGRES_DB=enviromesh
POSTGRES_USER=enviromesh_app
POSTGRES_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_PASSWORD
