
# EnviroMesh - database
POSTGRES_DB=enviromesh
POSTGRES_USER=enviromesh_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_PORT=5432

# EnviroMesh - MQTT broker
# Prefer binding to the Raspberry Pi's LAN IP instead of all interfaces.
MQTT_BIND_IP=0.0.0.0
MQTT_PORT=1883

# EMQX dashboard
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
EMQX_DASHBOARD_PORT=18083
