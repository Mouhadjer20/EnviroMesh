# ==============================================================================
# EnviroMesh — Root Environment Configuration Template (.env.example)
#
# Configures both:
# 1. Unified Single-Device Docker Compose stack (Gateway + Core services)
# 2. Local Python scripts & test tools (simulate_telemetry.py, lora_packet_inject.py,
#    db_manage.sh, check_health.py, and direct host backend runs)
#
# Usage:
#   cp .env.example .env
#   nano .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Web Dashboard & Reverse Proxy (Nginx)
# ------------------------------------------------------------------------------
WEB_BIND_IP=0.0.0.0
WEB_PORT=8080

# ------------------------------------------------------------------------------
# MQTT Broker & Telemetry Ingestion (Field Nodes, Gateway & Simulator)
# ------------------------------------------------------------------------------
# Standard MQTT host & port (used by simulators, field nodes, and host scripts)
EMQX_URL=localhost
MQTT_HOST=localhost
MQTT_PORT=1883

# Local Gateway broker listener (bind address & port for Docker container)
MQTT_LOCAL_BIND_IP=0.0.0.0
MQTT_LOCAL_PORT=1883

# MQTT Telemetry Topics & Prefix
# - Wi-Fi nodes & simulators publish to: enviromesh/devices/<DEVICE_ID>/telemetry
# - Gateway ingests from wildcard: enviromesh/devices/+/telemetry
MQTT_TOPIC=enviromesh/devices/+/telemetry
TOPIC_PREFIX=enviromesh/devices
TOPIC_PRIFIX=enviromesh/devices/+/telemetry

# Local Gateway EMQX Dashboard & Management
EMQX_LOCAL_DASHBOARD_BIND_IP=127.0.0.1
EMQX_LOCAL_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=admin123
EMQX_LOCAL_DASHBOARD_USERNAME=admin
EMQX_LOCAL_DASHBOARD_PASSWORD=admin123

# Gateway Ingestion client credentials on local broker
MQTT_LOCAL_USERNAME=gw_ingestion
MQTT_LOCAL_PASSWORD=gw_ingest_secret

# ------------------------------------------------------------------------------
# RPi 1 Gateway — Processing & Offline Queue
# ------------------------------------------------------------------------------
GATEWAY_ID=GW01
GATEWAY_LAN_IP=127.0.0.1

QUEUE_MAX_MESSAGES=50000
FORWARD_BATCH_SIZE=10
FORWARD_RETRY_SECONDS=5

# Forwarding target (emqx-core service in Docker network)
MQTT_CORE_HOST=emqx-core
MQTT_CORE_PORT=1883
MQTT_CORE_USE_TLS=false
MQTT_CORE_USERNAME=gw_forwarder
MQTT_CORE_PASSWORD=gw_forward_secret

# ------------------------------------------------------------------------------
# RPi 2 Core — Central EMQX Broker (Core Receiving Layer)
# ------------------------------------------------------------------------------
MQTT_TLS_BIND_IP=0.0.0.0
MQTT_TLS_PORT=8883
MQTT_CORE_DEBUG_PORT=1884

EMQX_CORE_DASHBOARD_PORT=18084
EMQX_CORE_DASHBOARD_USERNAME=admin
EMQX_CORE_DASHBOARD_PASSWORD=admin123
EMQX_NODE_COOKIE=enviromesh_secret_cookie_change_in_production

# Application (backend subscriber) credentials on core broker
MQTT_APP_USERNAME=enviromesh_backend
MQTT_APP_PASSWORD=backend_secret_pass

# ------------------------------------------------------------------------------
# PostgreSQL + TimescaleDB Database
# ------------------------------------------------------------------------------
# Container initialization & Docker service credentials
POSTGRES_DB=enviromesh
POSTGRES_USER=enviromesh_app
POSTGRES_PASSWORD=enviromesh_secret_db_pass

# Database host connection (used by db_manage.sh, python host backend, and test scripts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enviromesh
DB_USER=enviromesh_app
DB_PASSWORD=enviromesh_secret_db_pass

# ------------------------------------------------------------------------------
# User Authentication & RBAC (PR #13)
# ------------------------------------------------------------------------------
# Set to 'false' only for unauthenticated local development
AUTH_REQUIRED=true
# Minimum 32 characters for HS256 JWT secret
JWT_SECRET=enviromesh_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRE_MINUTES=60
